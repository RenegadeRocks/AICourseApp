# Copy to .env and fill in. NEVER commit .env.

# --- Voice platform (pick one) ---
# Vapi: https://dashboard.vapi.ai/  (Account -> API Keys)
VAPI_API_KEY=
# Retell: https://dashboard.retellai.com/  (Settings -> API Keys)
RETELL_API_KEY=

# --- WhatsApp Cloud API (Meta) ---
# https://developers.facebook.com/  -> your app -> WhatsApp -> API Setup
WA_ACCESS_TOKEN=            # temporary 24h token for sandbox, or a system-user token
WA_PHONE_NUMBER_ID=         # the test number's phone_number_id
WA_VERIFY_TOKEN=changeme    # you invent this; paste the same value in the webhook config

# --- Optional: local voice-note STT ---
# Only needed if you transcribe .ogg yourself instead of using Meta's transcription.
DEEPGRAM_API_KEY=

# --- Brain config ---
ALLOW_WRITES=false          # Thursday's guardrail: transacting tools stay off until you
                            # implement confirmation-read + hard caps. Do not flip to true
                            # without reading tools/gateway.py.
EVENTS_PATH=events.jsonl
