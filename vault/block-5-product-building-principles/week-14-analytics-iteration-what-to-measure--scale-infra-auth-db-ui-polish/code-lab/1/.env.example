# Copy to .env for local dev. NEVER commit the real .env (Thursday: 12-Factor).
# The metrics endpoint is bearer-protected; set a long random token.
METRICS_TOKEN=change-me-to-a-long-random-string

# Optional. Unset => in-memory Postgres (resets each boot). Set => persistent.
# DATABASE_DIR=./pgdata

# PORT=3000
# NODE_ENV=development
